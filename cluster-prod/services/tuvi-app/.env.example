# Copy thành .env (đã gitignore) rồi điền giá trị thật trước khi chạy scripts/create-tenant.sh.
TZ=Asia/Ho_Chi_Minh
# Mật khẩu = giá trị PASSWORD trong services/tuvi-db/.env
DATABASE_URL=postgresql://tuvi:<mật-khẩu>@prod-tuvi-db.tuvi-db.svc.cluster.local:5432/tuvi

# Chỉ để sinh imagePullSecret kéo image từ Nexus.
REGISTRY_SERVER=registry.kruzetech.dev
REGISTRY_USER=<nexus-user>
REGISTRY_PASSWORD=<nexus-pass>
