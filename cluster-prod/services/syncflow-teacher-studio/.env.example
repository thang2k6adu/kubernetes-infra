# Copy thành .env (đã gitignore) rồi điền giá trị thật trước khi chạy scripts/create-tenant.sh.
# Frontend không có biến runtime; chỉ cần credential Nexus để sinh imagePullSecret katech-registry.
TZ=Asia/Ho_Chi_Minh

REGISTRY_SERVER=registry.kruzetech.dev
REGISTRY_USER=<nexus-user>
REGISTRY_PASSWORD=<nexus-pass>
